{
  "name": "mdify",
  "productName": "Mdify",
  "version": "1.0.0",
  "description": "Convert any file or folder into clean Markdown.",
  "author": "Imran",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "electron:dev": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --publish never",
    "build:desktop": "tsc -p tsconfig.json && vite build --mode electron && npm run build:electron",
    "dist:linux": "npm run build:desktop && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "dev.imran.mdify",
    "productName": "Mdify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine/dist/mdify-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mdify-Setup-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "gpt-tokenizer": "^4.0.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "motion": "^13.4.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5"
  }
}
